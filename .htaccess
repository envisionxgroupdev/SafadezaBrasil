Options -Indexes
AddDefaultCharset UTF-8
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Links bonitos (ative PRETTY_URLS no config.php)
  RewriteRule ^video/([0-9]+)(?:/([^/]*))?/?$ video.php?id=$1&s=$2 [L,QSA]
  RewriteRule ^categoria/([^/]+)/?$ category.php?c=$1 [L,QSA]
</IfModule>

<FilesMatch "^(config\.php|.*\.sql|.*\.json)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Rating "RTA-5042-1996-1400-1577-RTA"
</IfModule>
